{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jsconf-br",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-03-10",
  "no_bundle": false,
  "send_metrics": false,
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "api.jsconf.com.br",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jsconf-br",
      "database_id": "local"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  }
}
