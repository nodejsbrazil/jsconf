{
  "name": "jsconf-br",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "concurrently \"npm:website -- pt-BR\" \"npm:server\"",
    "start:en": "concurrently \"npm:website -- en-US\" \"npm:server\"",
    "start:es": "concurrently \"npm:website -- es-419\" \"npm:server\"",
    "website": "docusaurus start --host 0.0.0.0 --locale",
    "server": "wrangler dev",
    "host": "tsx tools/host.ts",
    "db:init": "wrangler d1 execute jsconf-br --file='resources/schema.sql'",
    "db:init:remote": "npm run db:init -- --remote",
    "build": "docusaurus build",
    "clear": "docusaurus clear",
    "reset": "(npm run clear || true) && rm -rf node_modules package-lock.json && npm i && npm run update",
    "preview": "docusaurus serve",
    "typecheck": "tsc",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "update": "pu && npm i && npm update && (npm audit fix || true) && npm run lint:fix",
    "purge": "tsx --env-file-if-exists=.env tools/purge-cache.mts",
    "test": "poku -r=compact"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260312.1",
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mdx-js/react": "^3.1.1",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "docusaurus-plugin-sass": "^0.2.6",
    "lru.min": "^1.1.4",
    "lucide-react": "^0.577.0",
    "packages-update": "^2.0.0",
    "poku": "^4.1.0",
    "prettier": "^3.8.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-parallax-tilt": "^1.7.320",
    "react-typed": "^2.0.12",
    "sass": "^1.98.0",
    "sonner": "^2.0.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.72.0",
    "zod": "^4.3.6"
  },
  "browserslist": {
    "production": [
      ">0%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "private": true
}
