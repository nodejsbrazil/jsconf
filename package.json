{
  "name": "jsconf-br",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "tsx tools/host.ts",
    "start": "DOCUSAURUS_BROWSER=Arc docusaurus start --host 0.0.0.0",
    "prestart:en": "tsx tools/host.ts",
    "start:en": "docusaurus start --locale en",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "reset": "(npm run clear || true) && rm -rf node_modules package-lock.json && npm i && npm run update",
    "prepreview": "tsx tools/host.ts",
    "preview": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "update": "pu && npm i && npm update && (npm audit fix || true)",
    "postupdate": "npm run lint:fix",
    "purge": "tsx --env-file-if-exists=.env tools/purge-cache.mts"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.9.2",
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@docusaurus/tsconfig": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@mdx-js/react": "^3.1.1",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "docusaurus-plugin-sass": "^0.2.6",
    "lucide-react": "^0.563.0",
    "packages-update": "^2.0.0",
    "poku": "^3.0.3-canary.c443b1b8",
    "prettier": "^3.8.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-intersection-observer": "^10.0.2",
    "react-parallax-tilt": "^1.7.316",
    "react-typed": "^2.0.12",
    "sass": "^1.97.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "browserslist": {
    "production": [
      ">0%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "private": true
}
