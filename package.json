{
  "name": "jsconf-br",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "concurrently \"npm:website -- pt-BR\" \"npm:server\"",
    "start:en": "concurrently \"npm:website -- en-US\" \"npm:server\"",
    "start:es": "concurrently \"npm:website -- es-419\" \"npm:server\"",
    "website": "docusaurus start --host 0.0.0.0 --locale",
    "server": "wrangler dev",
    "host": "tsx tools/host.ts",
    "db:init": "wrangler d1 execute jsconf-br --file='resources/schema.sql'",
    "db:init:remote": "wrangler d1 execute jsconf-br --file='resources/schema.sql' --remote --config server/wrangler.jsonc",
    "predb:init:remote": "npm run worker:prepare",
    "build": "npm run build:server && docusaurus build",
    "build:server": "npm run worker:prepare && rollup -c",
    "clear": "docusaurus clear",
    "reset": "(npm run clear || true) && rm -rf node_modules package-lock.json && npm i && npm run update",
    "preview": "docusaurus serve",
    "typecheck": "tsc",
    "lint": "prettier --check .",
    "lint:fix": "prettier --write .",
    "update": "pu && npm i && npm update && (npm audit fix || true) && npm run lint:fix",
    "purge": "tsx --env-file-if-exists=.env tools/purge-cache.mts",
    "test": "poku -r=compact",
    "deploy": "wrangler deploy --config server/wrangler.jsonc server/index.js",
    "predeploy": "npm run build:server",
    "secret": "wrangler secret put --config server/wrangler.jsonc",
    "presecret": "npm run worker:prepare",
    "worker:prepare": "tsx --env-file-if-exists=.env tools/prepare-worker.mts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260408.1",
    "@docusaurus/core": "^3.10.0",
    "@docusaurus/module-type-aliases": "3.10.0",
    "@docusaurus/preset-classic": "3.10.0",
    "@docusaurus/tsconfig": "3.10.0",
    "@docusaurus/types": "3.10.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@mdx-js/react": "^3.1.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "docusaurus-plugin-sass": "^0.2.6",
    "jsonc.min": "^1.1.2",
    "lru.min": "^1.1.4",
    "lucide-react": "^1.7.0",
    "packages-update": "^2.0.0",
    "poku": "^4.2.1",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-parallax-tilt": "^1.7.322",
    "react-typed": "^2.0.12",
    "rollup": "^4.60.1",
    "sass": "^1.99.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "wrangler": "^4.81.0",
    "zod": "^4.3.6"
  },
  "browserslist": {
    "production": [
      ">0%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "private": true,
  "dependencies": {
    "stripe": "^22.0.0"
  }
}
